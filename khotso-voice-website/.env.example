# Required: create an API key in the OpenAI API platform.
# Keep this key private and server-side. Never put it in static/app.js.
OPENAI_API_KEY=sk-your-key-here

# Typed-message model.
OPENAI_MODEL=gpt-5

# Live speech-to-speech model.
OPENAI_REALTIME_MODEL=gpt-realtime

# Live captions for your microphone audio.
OPENAI_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe

# Strongly recommended whenever anyone besides you can reach the website.
APP_PASSWORD=choose-a-long-private-password
SESSION_SECRET=replace-with-a-long-random-secret

# false for local http://127.0.0.1. true for an HTTPS deployment.
SESSION_COOKIE_SECURE=false

# Optional server and storage settings.
PORT=5000
MAX_HISTORY_MESSAGES=36
DATABASE_PATH=data/khotso.db
OPENAI_TIMEOUT_SECONDS=120
